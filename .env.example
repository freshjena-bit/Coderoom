# ============================================
# Database Connection (Supabase / PostgreSQL)
# ============================================
# For local PostgreSQL:
# DATABASE_URL=postgresql://coderoom:coderoom_pass@127.0.0.1:5432/coderoom
# DIRECT_URL=postgresql://coderoom:coderoom_pass@127.0.0.1:5432/coderoom
#
# For Supabase (recommended for Vercel deployment):
# 1. Go to https://supabase.com and create a new project
# 2. Go to Project Settings > Database > Connection string
# 3. Copy the "Transaction" URL (uses port 6543 with pgBouncer pooling) for DATABASE_URL
# 4. Copy the "Session" URL (uses port 5432) for DIRECT_URL
# 5. Replace [YOUR-PASSWORD] with your database password

DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].supabase.com:5432/postgres

# ============================================
# Session Secret
# ============================================
# Generate a random string for production (e.g. openssl rand -hex 32)
SESSION_SECRET=change-this-to-a-random-secret-key
